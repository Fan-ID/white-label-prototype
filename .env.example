SOUNDLINK_API_KEY=sk_your_key_here
SOUNDLINK_API_BASE_URL=https://api.getsoundlink.com

# On Vercel, prefer APP_TURSO_* (fixed main DB). The marketplace integration
# injects TURSO_* pointing at a per-deploy branch, which wipes local state.
APP_TURSO_DATABASE_URL=
APP_TURSO_AUTH_TOKEN=
# Fallback (integration / local):
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
# Optional locally — if unset, uses file:data/prototype.db
